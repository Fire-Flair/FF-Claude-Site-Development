{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FireFlair456/FF-Claude-Site-Development/data/companies/company-profile.schema.json",
  "title": "FireFlair company profile, format version 2",
  "description": "One company page in the shape the company builder writes. One file per company in data/companies/profiles/<slug>.json. Written by the directory agent, by FireFlair and by the company; the source of each item says which (see docs/company-profile-format.md and data/companies/AGENT.md). Rules a schema cannot hold (no currency amounts in agent text, nothing written by the agent after a claim, unique slugs and tags, areas that match a place) are checked by npm run check-companies.",
  "type": "object",
  "required": ["formatVersion", "slug", "name", "kind", "description", "areas", "meta"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "const": 2 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60, "description": "The company address word. Matches the file name." },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "kind": { "type": "string", "minLength": 1, "maxLength": 70, "description": "One short line, for example Luxury mobile cocktail bar." },
    "base": { "type": "string", "description": "Where the company is based, as a place name the way the company states it. May be empty when it is not stated." },
    "areas": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Places covered, as the company states them. The build resolves each to a place id and lists the ones it cannot." },
    "logo": { "type": "string", "description": "Address of the logo image." },
    "logoBg": { "enum": ["dark", "light"], "description": "Whether the logo sits on a dark or a light backing." },
    "logoWide": { "type": "boolean" },
    "areasNote": { "type": "string", "description": "One sentence on where the company works, shown with its first area." },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": { "type": "string", "description": "The Company Card colour, as the builder names it (for example onyx)." },
        "layout": { "enum": ["classic", "logo", "centre"], "description": "The Company Card layout." },
        "plate": { "type": "boolean", "description": "Show the Company Card plate top left and no FF logo, as directory cards do, even though the company has signed up." }
      },
      "description": "How the Company Card looks. Set by the company or by us; the agent leaves it out."
    },
    "description": { "type": "string", "description": "The About text. Paragraphs are separated by a blank line." },
    "aboutSource": { "$ref": "#/$defs/source", "description": "Who wrote the About text." },
    "media": { "type": "array", "items": { "$ref": "#/$defs/photo" }, "description": "The gallery, in display order." },
    "info": { "type": "array", "items": { "$ref": "#/$defs/section" }, "description": "The company's own sections, in display order. Their cards are in records.info_<id>." },
    "records": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packages": { "$ref": "#/$defs/cards" },
        "cocktail_menu": { "$ref": "#/$defs/cards" },
        "web_reviews": { "$ref": "#/$defs/cards" },
        "contact": { "$ref": "#/$defs/cards" }
      },
      "patternProperties": { "^info_[a-z0-9_-]+$": { "$ref": "#/$defs/cards" } }
    },
    "qa": { "type": "array", "items": { "$ref": "#/$defs/qa" } },
    "meta": { "$ref": "#/$defs/meta" }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 80 },
    "source": {
      "type": "object",
      "required": ["by", "at"],
      "additionalProperties": false,
      "properties": {
        "by": { "enum": ["agent", "fireflair", "owner"] },
        "url": { "type": "string", "description": "The page the agent read. Required when by is agent." },
        "at": { "$ref": "#/$defs/date" }
      }
    },
    "photo": {
      "type": "object",
      "required": ["id", "src"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "src": { "type": "string", "minLength": 1 },
        "alt": { "type": "string", "description": "The caption." },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "document": {
      "type": "object",
      "required": ["name", "src"],
      "additionalProperties": false,
      "properties": { "name": { "type": "string" }, "src": { "type": "string" }, "type": { "type": "string" } }
    },
    "card": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 150, "description": "The card title." },
        "description": { "type": "string", "maxLength": 2000 },
        "media": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/photo" }, "description": "Up to 5 photos." },
        "document": { "$ref": "#/$defs/document", "description": "One PDF." },
        "hidden": { "type": "boolean" },
        "proposed": { "type": "boolean", "description": "True on a card the agent adds beside one a person has edited. It waits for a person to accept it and is not shown." },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "cards": { "type": "array", "items": { "$ref": "#/$defs/card" } },
    "section": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "lead": { "type": "string" },
        "text": { "type": "string" },
        "chips": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "numbered": { "type": "boolean" },
        "quote": { "type": "string" },
        "proposed": { "type": "boolean" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "qa": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "group": { "enum": ["business", "feedback"] },
        "text": { "type": "string", "minLength": 1 },
        "answer": { "enum": ["Yes", "No", ""] },
        "note": { "type": "string" },
        "proposed": { "type": "boolean" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "pin": {
      "type": "object",
      "required": ["label", "lat", "lng"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "approx": { "type": "boolean", "description": "True when the base was not stated and needs confirming with the company." }
      }
    },
    "meta": {
      "type": "object",
      "required": ["status", "category", "tag", "permission"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["directory", "claim-pending", "claimed"] },
        "statusAt": { "$ref": "#/$defs/date", "description": "The day the status last changed. Required once the status is claim-pending or claimed." },
        "category": { "enum": ["bar", "dj", "photo", "catering", "svc"] },
        "sub": { "enum": ["ice", "glassware", "events"], "description": "Only for category svc." },
        "tag": { "type": "string", "pattern": "^[A-Z0-9]{2,8}$", "description": "The short code on the Company Card. Unique across all files." },
        "tier": { "enum": ["standard", "bronze", "silver", "gold"], "description": "Verification level, set by us. Leave out for a company that has not been given one." },
        "partner": { "type": "boolean", "description": "FireFlair partner company, shown on the Partners layer of the map." },
        "position": { "type": "integer", "minimum": 0, "description": "Place in the directory list. Lower comes first; a file without one goes last, by slug." },
        "legal": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "form": { "enum": ["limited", "sole", null] },
            "legalName": { "type": ["string", "null"] },
            "companyNumber": { "type": ["string", "null"] }
          }
        },
        "source": {
          "type": "object",
          "required": ["urls", "retrievedAt"],
          "additionalProperties": false,
          "properties": {
            "urls": { "type": "array", "items": { "type": "string" } },
            "retrievedAt": { "$ref": "#/$defs/date" }
          }
        },
        "permission": {
          "type": "object",
          "required": ["text", "images"],
          "additionalProperties": false,
          "properties": {
            "text": { "enum": ["own-words", "granted"] },
            "images": { "enum": ["none", "to_confirm", "granted"] }
          }
        },
        "verifiedBy": { "type": ["string", "null"], "description": "Who checked the draft before it was shown." },
        "pins": { "type": "array", "items": { "$ref": "#/$defs/pin" }, "description": "Map pins at town or city level, never an address." }
      }
    }
  }
}
