{
  "name": "ff-claude-site-development",
  "private": true,
  "description": "FireFlair prototype: src/ is the source, the single-file HTML is a build output.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "stories": "python3 scripts/build-stories.py --src src",
    "check": "node scripts/check-src.mjs",
    "publish-build": "python3 scripts/split-images.py build/fireflair-v17.4.html build/release"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
